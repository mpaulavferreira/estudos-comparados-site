---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { IDIOMAS, NOME_IDIOMA, t, rota, PADRAO, type Idioma } from '../i18n/ui';
import { PAISES } from '../data/paises';

interface Props { lang: Idioma; titulo?: string; descricao?: string; caminho?: string }
const { lang, titulo, descricao, caminho = '/' } = Astro.props;
const nomeSite = t(lang, 'site.nome');
const tituloPagina = titulo ? `${titulo} · ${nomeSite}` : `${nomeSite} · ${t(lang, 'site.lema')}`;

const menu = [
  ['nav.pesquisa', '/pesquisa'], ['nav.paises', '/paises'], ['nav.historias', '/historias'],
  ['nav.biblioteca', '/biblioteca'], ['nav.novidades', '/novidades'], ['nav.quem', '/quem-somos'],
] as const;

// Itens do "Para onde vamos?": países + seções. Qualquer destino a 1 clique + 1 tecla.
const destinos = [
  ...PAISES.map((p) => ({ nome: p.nome[lang], url: rota(lang, `/paises/${p.slug}`), cor: p.cor, tipo: t(lang, 'nav.paises') })),
  ...menu.map(([k, u]) => ({ nome: t(lang, k), url: rota(lang, u), cor: 'var(--tinta)', tipo: '' })),
  { nome: t(lang, 'nav.contato'), url: rota(lang, '/contato'), cor: 'var(--tinta)', tipo: '' },
];
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao ?? t(lang, 'home.sub')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {IDIOMAS.map((l) => <link rel="alternate" hreflang={l} href={new URL(rota(l, caminho), Astro.site)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Fraunces:opsz,wght,SOFT,WONK@9..144,500..800,100,1&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body>
    <a class="pular" href="#conteudo">{t(lang, 'pular')}</a>
    <header class="topo">
      <div class="envelope topo-linha">
        <a class="marca" href={rota(lang, '/')} aria-label={nomeSite}>
          <img src="/logo.png" alt="" width="160" height="56" />
        </a>
        <nav aria-label="Menu principal" class="menu">
          {menu.map(([k, u]) => <a href={rota(lang, u)} aria-current={caminho.startsWith(u) ? 'page' : undefined}>{t(lang, k)}</a>)}
        </nav>
        <div class="ferramentas">
          <button class="buscar" type="button" data-abrir-busca aria-haspopup="dialog" aria-label={t(lang, 'busca.abrir')}>
            <span aria-hidden="true">✈︎</span> <span class="buscar-texto">{t(lang, 'busca.abrir')}</span> <kbd>/</kbd>
          </button>
          <details class="idiomas">
            <summary aria-label="Idioma">{lang.toUpperCase()}</summary>
            <ul>{IDIOMAS.map((l) => <li><a href={rota(l, caminho)} lang={l} hreflang={l}>{NOME_IDIOMA[l]}</a></li>)}</ul>
          </details>
          <button type="button" class="acess" data-fonte aria-label="Aumentar letra">A+</button>
          <button type="button" class="acess" data-contraste aria-label="Alto contraste"><svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 2a8 8 0 0 1 0 16z" fill="currentColor"/></svg></button>
        </div>
      </div>
    </header>

    <dialog class="busca" aria-label={t(lang, 'busca.abrir')}>
      <form method="dialog">
        <label class="sr" for="campo-busca">{t(lang, 'busca.abrir')}</label>
        <input id="campo-busca" type="search" placeholder={t(lang, 'busca.placeholder')} autocomplete="off" />
        <ul class="resultados">
          {destinos.map((d) => (
            <li data-nome={d.nome.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '')}>
              <a href={d.url} style={`--cor:${d.cor}`}><span class="ponto"></span>{d.nome}<small>{d.tipo}</small></a>
            </li>
          ))}
        </ul>
        <p class="vazio" hidden>{t(lang, 'busca.vazio')}</p>
      </form>
    </dialog>

    <main id="conteudo"><slot /></main>

    <footer class="rodape">
      <div class="envelope rodape-grade">
        <div>
          <img src="/logo.png" alt={nomeSite} width="180" height="63" />
          <p>{t(lang, 'site.lema')}</p>
        </div>
        <nav aria-label="Rodapé">
          {menu.map(([k, u]) => <a href={rota(lang, u)}>{t(lang, k)}</a>)}
          <a href={rota(lang, '/contato')}>{t(lang, 'nav.contato')}</a>
        </nav>
        <p class="apoio">{t(lang, 'rodape.financiadores')}<br />Laboratório ECoS · Universidade de Brasília</p>
      </div>
    </footer>

    <script>
      // Roda a cada navegação (ClientRouter mantém a página viva entre cliques).
      function iniciar() {
        const dlg = document.querySelector<HTMLDialogElement>('dialog.busca');
        const campo = document.querySelector<HTMLInputElement>('#campo-busca');
        const itens = [...document.querySelectorAll<HTMLLIElement>('.resultados li')];
        const vazio = document.querySelector<HTMLElement>('.busca .vazio');
        const abrir = () => { dlg?.showModal(); campo?.focus(); };
        document.querySelectorAll('[data-abrir-busca]').forEach((b) => b.addEventListener('click', abrir));
        campo?.addEventListener('input', () => {
          const q = campo.value.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '');
          let n = 0;
          itens.forEach((li) => { const ok = li.dataset.nome!.includes(q); li.hidden = !ok; if (ok) n++; });
          if (vazio) vazio.hidden = n > 0;
        });
        campo?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') { const a = itens.find((li) => !li.hidden)?.querySelector('a'); if (a) { e.preventDefault(); a.click(); } }
        });
        dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

        // Acessibilidade: tamanho da letra e contraste, lembrados no navegador.
        const raiz = document.documentElement;
        const ler = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
        const gravar = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
        let escala = Number(ler('ec-fonte') || 1); raiz.style.setProperty('--escala-fonte', String(escala));
        if (ler('ec-contraste') === 'alto') raiz.dataset.contraste = 'alto';
        document.querySelector('[data-fonte]')?.addEventListener('click', () => {
          escala = escala >= 1.3 ? 1 : +(escala + 0.15).toFixed(2); gravar('ec-fonte', String(escala)); raiz.style.setProperty('--escala-fonte', String(escala));
        });
        document.querySelector('[data-contraste]')?.addEventListener('click', () => {
          const alto = raiz.dataset.contraste !== 'alto'; if (alto) raiz.dataset.contraste = 'alto'; else delete raiz.dataset.contraste; gravar('ec-contraste', alto ? 'alto' : '');
        });

        // Revelar blocos ao rolar.
        const obs = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visivel'); obs.unobserve(e.target); } }), { threshold: 0.15 });
        document.querySelectorAll('.revelar').forEach((el) => obs.observe(el));
      }
      document.addEventListener('keydown', (e) => {
        const alvo = e.target as HTMLElement;
        if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(alvo.tagName)) { e.preventDefault(); document.querySelector<HTMLDialogElement>('dialog.busca')?.showModal(); document.querySelector<HTMLInputElement>('#campo-busca')?.focus(); }
      });
      document.addEventListener('astro:page-load', iniciar);
    </script>

    <style>
      .topo { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--papel) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--linha); }
      .topo-linha { display: flex; align-items: center; gap: 20px; min-height: 68px; }
      .marca img { height: 44px; width: auto; }
      .menu { display: flex; gap: 18px; flex-wrap: wrap; font-weight: 700; font-size: .95rem; }
      .menu a { text-decoration: none; color: var(--texto); padding: 4px 0; border-bottom: 2px solid transparent; }
      .menu a[aria-current='page'], .menu a:hover { border-color: var(--seta-vermelha); color: var(--tinta); }
      .ferramentas { margin-left: auto; display: flex; align-items: center; gap: 8px; }
      .buscar { display: inline-flex; gap: 8px; align-items: center; background: var(--tinta); color: #fff; border: 0; border-radius: 999px; padding: 10px 16px; font: inherit; font-weight: 700; cursor: pointer; }
      .buscar kbd { background: rgb(255 255 255 / .2); border-radius: 4px; padding: 0 6px; font-size: .8rem; }
      .acess, .idiomas summary { background: #fff; border: 1px solid var(--linha); border-radius: 999px; min-width: 40px; height: 40px; font: inherit; font-weight: 700; color: var(--tinta); cursor: pointer; display: grid; place-items: center; list-style: none; }
      .idiomas { position: relative; }
      .idiomas ul { position: absolute; right: 0; top: 46px; background: #fff; border-radius: 12px; box-shadow: var(--sombra); list-style: none; margin: 0; padding: 8px; min-width: 140px; }
      .idiomas a { display: block; padding: 6px 10px; text-decoration: none; border-radius: 8px; }
      .idiomas a:hover { background: var(--globo-claro); }
      .busca { border: 0; border-radius: 22px; padding: 0; width: min(640px, calc(100% - 32px)); box-shadow: 0 30px 80px -20px rgb(18 40 90 / .5); }
      .busca::backdrop { background: rgb(18 40 90 / .45); backdrop-filter: blur(3px); }
      .busca input { width: 100%; border: 0; border-bottom: 1px solid var(--linha); padding: 20px 22px; font: inherit; font-size: 1.2rem; outline: none; }
      .resultados { list-style: none; margin: 0; padding: 8px; max-height: 60vh; overflow: auto; }
      .resultados a { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 12px; text-decoration: none; color: var(--texto); font-weight: 700; }
      .resultados a:hover, .resultados a:focus { background: var(--globo-claro); }
      .resultados small { margin-left: auto; color: var(--texto-suave); font-weight: 400; }
      .resultados .ponto { width: 12px; height: 12px; border-radius: 50%; background: var(--cor); }
      .busca .vazio { padding: 0 22px 18px; color: var(--texto-suave); }
      .rodape { background: var(--tinta-forte); color: #dfe7f7; padding-block: 56px; margin-top: 64px; }
      .rodape img { filter: brightness(0) invert(1); height: 48px; width: auto; }
      .rodape a { color: #fff; display: block; padding: 3px 0; }
      .rodape-grade { display: grid; gap: 32px; grid-template-columns: 1.4fr 1fr 1.2fr; }
      .apoio { font-size: .9rem; opacity: .85; }
      @media (max-width: 960px) {
        .menu { display: none; } /* no celular, o botão "Para onde vamos?" é o menu */
        .buscar kbd { display: none; }
        .rodape-grade { grid-template-columns: 1fr; }
      }
      @media (max-width: 560px) { .buscar-texto { display: none; } .buscar { width: 44px; height: 44px; padding: 0; justify-content: center; } .acess { display: none; } }
    </style>
  </body>
</html>
